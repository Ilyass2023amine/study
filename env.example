# StudyVerse — public, browser-safe configuration only.
# Copy this file to `.env.local` and fill in values from your Supabase project
# (Project Settings → API). The anon/publishable key is designed for the browser;
# it is still protected by Row Level Security.

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Never put the service_role key or any AI provider key in this file.
# AI provider keys belong only in Supabase Edge Function secrets.
